DEPS=""
for r in $REQUIRES; do
    [ "$r" = "defaults-release" ] && continue
    R="${r^^}"; R="${R//-/_}"
    ver="${R}_VERSION"; hash="${R}_HASH"
    DEPS+="$r=${!ver}_${!hash} "
done
DEPS="$(echo "$DEPS" | sed 's/[[:space:]]*$//')"

DEPS_DEFINE=()
[ -n "$DEPS" ] && DEPS_DEFINE=(--define "deps $DEPS")

mkdir -p $INSTALLROOT/etc/rpm

rpmbuild -bb \
  --define "pkgname $PKGNAME" \
  --define "workdir $WORK_DIR" \
  --define "pkgversion $PKGVERSION" \
  --define "pkghash $PKGHASH" \
  --define "tree $INSTALLROOT" \
  --define "_rpmdir $INSTALLROOT/etc/rpm" \
  --define "arch $(uname -m)" \
  --define "_build_name_fmt %%{NAME}-%%{VERSION}.%%{ARCH}.rpm" \
  "${DEPS_DEFINE[@]}" \
  $BITS_CONFIG_DIR/external.spec.in

mkdir -p "$INSTALLROOT/etc/profile.d"

cat << EoF >> "$INSTALLROOT/etc/profile.d/post-relocate.sh"
DBPATH="\$WORK_DIR/var/lib/rpm"
RPMFILE="\$WORK_DIR/$ARCHITECTURE/$PKGFAMILY/$PKGNAME/$PKGVERSION-$PKGREVISION/etc/rpm/${PKGNAME}-${PKGVERSION}_${PKGHASH}.$(uname -m).rpm"

if [ ! -e "\$DBPATH/rpmdb.sqlite" ]; then
  mkdir -p "\$DBPATH"
  rpm --dbpath "\$DBPATH" --initdb
fi

if [ "$PKGNAME" = "system-externals" ]; then
  rpm -i --dbpath "\$DBPATH" --nodeps "\$RPMFILE"
else
  rpm -i --dbpath "\$DBPATH" --test "\$RPMFILE" && \
  rpm -i --dbpath "\$DBPATH" "\$RPMFILE"
fi
EoF
