#!/bin/sh
# POST_INSTALL hook: generate a Tcl modulefile from the package's init.sh.
#
# Four sections, in this order (the order is load-bearing -- see below):
#   1. header            : magic cookie, whatis, conflict, module load BASE/1.0
#   2. dependencies      : module load <dep>/<verrev> for each RUNTIME_REQUIRES
#   3. own variables     : the `export` lines of init.sh, translated to setenv
#   4. path entries      : guarded prepend-path, evaluated at LOAD time
#
# Why translate rather than source init.sh: Modules can then reverse everything
# on unload, and it emits the right syntax for every shell (csh included), which
# a `puts stdout ". init.sh;"` cannot do.
#
# Why section 4 is emitted unconditionally rather than probed at build time:
# POST_INSTALL runs at build_template.sh:421 but the rsync to the final path is
# at :458, so at build time $<PKG>_ROOT does not exist yet and every probe would
# come back false -- which is exactly how an earlier version of this generator
# silently produced 609 modulefiles with no PATH at all. `file isdirectory` is
# evaluated by Tcl when the module is LOADED, when the tree is really there.
#
# ORDERING RULE: `$env(X)` on an unset variable is a hard Tcl error that aborts
# the whole load ("no such variable ... read trace on env(X)"), NOT an empty
# string. So section 3 must set <PKG>_ROOT before anything reads it, and nothing
# may reference a dependency's root this way -- a build-only dependency is never
# module-loaded, so its root would not exist.

set -eu

case "$PKGNAME" in
  defaults-*) echo "generate_module_template: $PKGNAME is a defaults package - skipping"; exit 0 ;;
esac
case " ${BITS_MODULE_SKIP:-} system-externals " in
  *" $PKGNAME "*) echo "generate_module_template: $PKGNAME skipped"; exit 0 ;;
esac

INITSH="$INSTALLROOT/etc/profile.d/init.sh"
[ -f "$INITSH" ] || { echo "generate_module_template: ERROR: no $INITSH" >&2; exit 1; }

# Mirror _VERREV in build_template.sh: an empty PKGREVISION (force_revision "")
# means the directory segment is the bare version, with no trailing dash.
if [ -n "${PKGREVISION:-}" ]; then VERREV="$PKGVERSION-$PKGREVISION"; else VERREV="$PKGVERSION"; fi
# package_family inserts a directory level (CMS uses external/ lcg/ cms/).
FAMSEG=""; [ -n "${PKGFAMILY:-}" ] && FAMSEG="$PKGFAMILY/"
SHELLID=$(printf '%s' "$PKGNAME" | tr -c 'A-Za-z0-9_' '_' | tr 'a-z' 'A-Z')

MODULEDIR="$INSTALLROOT/etc/modulefiles"
mkdir -p "$MODULEDIR"
OUT="$MODULEDIR/$PKGNAME"

# ---------------------------------------------------------------- 1. header --
cat > "$OUT" <<EOF
#%Module1.0
#
# Generated by cms.bits hooks/generate_module_template. Do not edit by hand.
#
proc ModulesHelp { } {
  puts stderr "CMS modulefile for $PKGNAME $VERREV"
}
module-whatis "CMS modulefile for $PKGNAME $VERREV"

conflict $PKGNAME

# BASE/1.0 defines BASEDIR, so it must be loaded before anything uses it.
module load BASE/1.0
EOF

# ------------------------------------------------------------ 2. dependencies --
# RUNTIME_REQUIRES only. REQUIRES would drag in build tools (gmake, autotools,
# CMake) that have no business in a runtime environment. Versions come from the
# <DEP>_VERSION / <DEP>_REVISION variables the dependency init.sh chain already
# exported into this hook's environment -- the same mechanism hooks/rpm_check.sh
# uses, and cheaper than parsing .meta.json with jq.
for _req in ${RUNTIME_REQUIRES:-}; do
  case "$_req" in defaults-*) continue ;; esac
  _id=$(printf '%s' "$_req" | tr -c 'A-Za-z0-9_' '_' | tr 'a-z' 'A-Z')
  eval "_v=\${${_id}_VERSION:-}"
  eval "_r=\${${_id}_REVISION:-}"
  if [ -z "$_v" ]; then
    echo "generate_module_template: WARNING: no ${_id}_VERSION in the environment;" \
         "omitting '$_req' from the module dependencies" >&2
    continue
  fi
  if [ -n "$_r" ]; then _dv="$_v-$_r"; else _dv="$_v"; fi
  {
    echo "if { ![is-loaded $_req/$_dv] } {"
    echo "    module load $_req/$_dv"
    echo "}"
  } >> "$OUT"
done

# --------------------------------------------------------- 3. own variables --
{
  echo ""
  echo "# Package root, derived at load time. No build-time path is baked in,"
  echo "# so this file survives relocation untouched."
  echo "setenv ${SHELLID}_ROOT \$::env(BASEDIR)/${FAMSEG}${PKGNAME}/${VERREV}"
  echo ""
} >> "$OUT"

# Command substitution has no Tcl equivalent. Translating it would silently
# store the literal text "$(echo ...)" as the value, which is worse than
# failing: the package builds, the module loads, and the variable is quietly
# wrong. Refuse instead, and name the offending recipe key.
if grep '^export ' "$INITSH" \
     | grep -v "^export ${SHELLID}_ROOT=" \
     | grep -qE '\$\(|`'; then
  echo "generate_module_template: ERROR: $PKGNAME has env: values containing" \
       "command substitution, which cannot be expressed in Tcl:" >&2
  grep '^export ' "$INITSH" | grep -E '\$\(|`' | sed 's/^/    /' >&2
  echo "  Fix the recipe to use bits templating (e.g. %(version)s or a" \
       "variables: entry), or give this package a hand-written modulefile." >&2
  exit 1
fi

# Sections 3b and 4 in one pass: every value-bearing line of init.sh, translated
# by hooks/init2tcl.awk. Doing it from init.sh rather than from a fixed list is
# what keeps recipe-declared prepend_path: / append_path: entries -- 34 recipes
# use prepend_path, and the two keys reach init.sh in different shapes.
awk -v shellid="$SHELLID" -f "$BITS_CONFIG_DIR/hooks/init2tcl.awk" "$INITSH" >> "$OUT"

# ------------------------------------------------------- relocation assert --
# The design rests on no build path being baked in; verify rather than trust.
if grep -qF "$WORK_DIR" "$OUT"; then
  echo "generate_module_template: ERROR: build path leaked into the modulefile:" >&2
  grep -nF "$WORK_DIR" "$OUT" >&2
  exit 1
fi

echo "generate_module_template: wrote $OUT"
