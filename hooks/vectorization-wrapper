#!/bin/bash
set -euo pipefail

profile="$INSTALLROOT/etc/profile.d"
target=$(cat "$INSTALLROOT/.bits-wrapper-target")
target_package=$(basename "$(dirname "$target")")
package_prefix="${PKGNAME,,}_"
target_arch="${target_package#"$package_prefix"}"
if [[ "$target_package" != "$package_prefix"* || ! "$target_arch" =~ ^[a-z0-9][a-z0-9_-]*$ ]]; then
  echo "Invalid vectorization target for $PKGNAME: $target_package" >&2
  exit 1
fi
target_init="$target/etc/profile.d/init.sh"
test -f "$target_init"
cp "$target/etc/deps/provides.json" "$INSTALLROOT/etc/deps/provides.json"

# Compute against the final tree, not the staging path under INSTALLROOT.
staging="$WORK_DIR/INSTALLROOT/$PKGHASH/"
[[ "$INSTALLROOT" == "$staging"* ]]
final_profile="$WORK_DIR/${INSTALLROOT#"$staging"}/etc/profile.d"
relative_init=$(realpath -ms --relative-to="$final_profile" "$target_init")
[[ "$relative_init" != /* ]]
wrapper_id=$(printf '%s' "$PKGNAME" | tr 'a-z-' 'A-Z_')
target_id=$(printf '%s_%s' "$PKGNAME" "$target_arch" | tr 'a-z-' 'A-Z_')
entry="init-$target_arch.sh"
{
  printf 'if [ -z "${%s_ROOT:-}" ]; then\n' "$target_id"
  printf '  . "${BASH_SOURCE[0]%%/*}"/%q || return $?\n' "$relative_init"
  printf 'fi\n'
  for key in ROOT VERSION HASH COMMIT INCLUDE_DIR; do
    printf 'if [ "${%s_%s+x}" ]; then export %s_%s="${%s_%s}"; fi\n' \
      "$target_id" "$key" "$wrapper_id" "$key" "$target_id" "$key"
  done
  printf 'export %s_REVISION=""\n' "$wrapper_id"
} > "$profile/$entry"
ln -sfn "$entry" "$profile/init.sh"

# The generated module loads the variants before exposing the wrapper alias.
module="$INSTALLROOT/etc/modulefiles/$PKGNAME"
if [[ -f "$module" ]]; then
  for key in ROOT VERSION HASH COMMIT INCLUDE_DIR; do
    printf 'if {[info exists env(%s_%s)]} { setenv %s_%s $env(%s_%s) }\n' \
      "$target_id" "$key" "$wrapper_id" "$key" "$target_id" "$key"
  done >> "$module"
fi
