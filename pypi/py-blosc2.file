build_requires:
- CMake
- ninja
- py-scikit-build-core
requires:
- c-blosc2
- py-scikit-build
- py-cython
- py-numpy
- py-msgpack
- py-ndindex
- py-py-cpuinfo
- py-rich
- py-numexpr
- py-httpx
- py-requests
- py-pydantic
- py-threadpoolctl
---
PipPreBuild='export CMAKE_ARGS="-DUSE_SYSTEM_BLOSC2=1 -DCMAKE_PREFIX_PATH=${C_BLOSC2_ROOT}"'
