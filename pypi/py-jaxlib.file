variables:
  # jaxlib publishes wheels only. Ask bits' pip:// fallback to select the
  # matching Python/platform wheel instead of pinning PyPI's opaque file path.
  pypi_source_name: "jaxlib-%(version)s-cp%(python_major_minor_str)s-cp%(python_major_minor_str)s-manylinux_2_27_%(platform_machine)s.whl"
  pypi_download_opts: "--python-version=%(python_major_minor_str)s+--abi=cp%(python_major_minor_str)s+--platform=manylinux_2_27_%(platform_machine)s+--no-deps+--only-binary=:all:"
requires:
- py-wheel
- py-ml_dtypes
- py-numpy
- py-scipy
---
