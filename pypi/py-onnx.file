build_requires:
- py-scikit-build-core
requires:
- CMake
- protobuf
- py-protobuf
- py-six
- py-typing-extensions
- py-numpy
- py-pytest-runner
- py-ml_dtypes
- abseil-cpp
---
PipPreBuildPy="export ONNX_ML=1; export CMAKE_ARGS=\"-DCMAKE_CXX_STANDARD=$CXXSTD -DONNX_USE_PROTOBUF_SHARED_LIBS=ON -DProtobuf_USE_STATIC_LIBS=OFF -DCMAKE_PREFIX_PATH=$PROTOBUF_ROOT;$ABSEIL_CPP_ROOT\""
