package: py-pyg-lib
sources:
- git+https://github.com/pyg-team/pyg-lib?obj=main/%(version)s&export=pyg-lib-%(version)s&submodules=1&output=/source.tar.gz
patches:
- pyg-lib.patch
build_requires:
- CMake
- ninja
requires:
- py-torch
- zlib
- abseil-cpp
---
# cmsdist: pip/pyg-lib.file -> ## INCLUDE pyg-lib-common -> ## INCLUDE torch-extension-build
# Include the modified shared hooks so their changes enter the recipe hash.
#!include <pypi/pyg-lib-common.file>
source "${BITS_CONFIG_DIR}/pypi/torch-extension-build.file"
