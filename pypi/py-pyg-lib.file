package: py-pyg-lib
version: 0.6.0
sources:
- git+https://github.com/pyg-team/pyg-lib?obj=master/%(version)s&export=pyg-lib-%(version)s&submodules=1&output=/source.tar.gz
patches:
- pyg-lib.patch
build_requires:
- CMake
- ninja
requires:
- py-torch
- zlib
---
# cmsdist: pip/pyg-lib.file -> ## INCLUDE pyg-lib-common -> ## INCLUDE torch-extension-build
# bits has no ## INCLUDE, so we source the two shared fragments here. BITS_CONFIG_DIR
# (== cms.bits) is exported by build.sh; the body runs before build-with-pip's runIt calls,
# so the hook vars they define (PipPatchSource, PipPreBuild, PipPreBuildPy, PipPostInstall)
# are in place by build time. Order matters: pyg-lib-common first, torch-extension-build
# second (matching cmsdist's include order, so build_flags resolves to -O2 as upstream does).
source "${BITS_CONFIG_DIR}/pypi/pyg-lib-common.file"
source "${BITS_CONFIG_DIR}/pypi/torch-extension-build.file"
