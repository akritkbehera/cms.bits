package: py-torch-cuda
version: 2.13.0
sources:
 - https://github.com/pytorch/pytorch/releases/download/v%(version)s/pytorch-v%(version)s.tar.gz
 - https://raw.githubusercontent.com/cms-sw/cmsdist/refs/heads/IB/CMSSW_20_1_X/g14/FindEigen3.cmake.file
patches:
 - pytorch-system-fmt.patch
 # cmsdist Patch1 for torch 2.13.
 - pytorch-hipblaslt-include.patch
build_requires:
 - CMake
 - ninja
 - py-packaging
requires:
 - eigen
 - FFTW3
 - fxdiv
 - numactl
 - openmpi
 - protobuf
 - psimd
 - Python
 - py-PyYAML
 - OpenBLAS
 - zlib
 - fmt
 - py-pybind11
 - py-typing-extensions
 - py-filelock
 - py-fsspec
 - py-Jinja2
 - py-networkx
 - py-sympy
 - cuda
 - cudnn
 - cuda-flags
---
# cmsdist: pip/torch-cuda.file -> ## INCLUDE pip/torch (+ CUDA overrides).
# Package is py-torch-cuda but it builds the "torch" pip distribution; set Pypi_name
# explicitly, else the framework derives Pypi_name=torch-cuda and pip3 show / source dir
# names break.
Pypi_name="torch"

# Shared base-torch hooks (PipPatchSource, PipPreBuild with CUDA OFF, PipPostInstall, and a
# PipPreBuildPy that just unsets CMAKE_ROOT).
source "${BITS_CONFIG_DIR}/pypi/torch-common.file"

# CUDA overrides. This PipPreBuildPy replaces the base one (so keep the CMAKE_ROOT unset) and
# runs after PipPreBuild, flipping USE_CUDA/USE_CUDNN ON. cuda_arch (from cuda-flags) -> dotted
# arch list; +PTX on the last arch mirrors cmsdist's cuda_arch_float macro (pip/torch-cuda).
PipPreBuildPy=$(cat <<'EOF'
 unset CMAKE_ROOT
 export USE_CUDA=ON
 export USE_CUDNN=ON
 export TORCH_CUDA_ARCH_LIST="$(echo "$cuda_arch" | tr ' ' '\n' | sed -E 's|([0-9])$|.\1|' | tr '\n' ' ' | sed -e 's/ *$/+PTX/')"
 export nvtx3_dir=${CUDA_ROOT}/include
 export CUDNN_ROOT=${CUDNN_ROOT}
EOF
)

# Rename torchrun so this package does not clash with the CPU py-torch's bin/torchrun.
PipPreInstall=$(cat <<'EOF'
mv $INSTALLROOT/bin/torchrun $INSTALLROOT/bin/torchrun-cuda
EOF
)
