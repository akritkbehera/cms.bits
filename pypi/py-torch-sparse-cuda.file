build_requires:
- CMake
- ninja
requires:
- py-torch-cuda
- zlib
# The pip:// source download uses the generator's pypi_name, which defaults to the package
# name minus "py-" (= "torch-sparse-cuda") and 404s on PyPI. Override it to the real dist
# name here (cmsdist's %%define pip_name). package.py also emits `export Pypi_name` from this,
# so it covers the build-time name too.
variables:
  pypi_name: torch-sparse
  pypi_source_name: torch-sparse-%(version)s.tar.gz
---
#!include <microarch-flags.file>
#!include <cuda-flags.file>
# cmsdist: pip/torch-sparse-cuda.file -> ## INCLUDE cuda-flags (+ CUDA overrides)
#                                     -> ## INCLUDE torch-sparse-common
#                                     -> ## INCLUDE torch-extension-build
# Pypi_name ("torch-sparse") comes from the variables: override in the frontmatter above.

source "${BITS_CONFIG_DIR}/pypi/torch-sparse-common.file"
source "${BITS_CONFIG_DIR}/pypi/torch-extension-build.file"

# CUDA override. Runs after torch-extension-build's PipPreBuild (FORCE_CUDA=0), turning it on.
# cuda_arch (from cuda-flags) -> dotted arch list; trailing space trimmed, no +PTX, per
# cmsdist pip/torch-sparse-cuda's cuda_arch_float macro.
PipPreBuildPy=$(cat <<'EOF'
export TORCH_CUDA_ARCH_LIST="$(echo "$cuda_arch" | tr ' ' '\n' | sed -E 's|([0-9])$|.\1|' | tr '\n' ' ' | sed 's| *$||')"
export FORCE_CUDA=1
# torch-sparse-common only adds -std=c++$CXXSTD to the 'cxx' flags, but the .cu sources go
# through nvcc, which then defaults to C++17 and rejects torch's C++20 headers
# (List_inl.h: "need 'typename'"). setup.py seeds its nvcc flags from $NVCC_FLAGS.
export NVCC_FLAGS="-std=c++${CXXSTD}"
EOF
)
