package: py-torch
version: 2.13.0
sources:
 - https://github.com/pytorch/pytorch/releases/download/v%(version)s/pytorch-v%(version)s.tar.gz
 - https://raw.githubusercontent.com/cms-sw/cmsdist/refs/heads/IB/CMSSW_20_1_X/g14/FindEigen3.cmake.file
patches:
 - pytorch-system-fmt.patch
 # cmsdist Patch1 for torch 2.13.
 - pytorch-hipblaslt-include.patch
build_requires:
 - CMake
 - ninja
 - py-packaging
requires:
 - eigen
 - FFTW3
 - fxdiv
 - numactl
 - openmpi
 - protobuf
 - psimd
 - Python
 - py-PyYAML
 - OpenBLAS
 - zlib
 - fmt
 - py-pybind11
 - py-typing-extensions
 - py-filelock
 - py-fsspec
 - py-Jinja2
 - py-networkx
 - py-sympy
---
# Base-torch build hooks live in the shared torch-common fragment (also used by
# py-torch-cuda). BITS_CONFIG_DIR (== cms.bits) is exported by build.sh; the body runs
# before build-with-pip's runIt calls, so the hook vars are in place by build time.
source "${BITS_CONFIG_DIR}/pypi/torch-common.file"
