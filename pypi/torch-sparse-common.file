# Shared build fragment for py-torch-sparse (and py-torch-sparse-cuda).
# Port of cmsdist pip/files/torch-sparse-common.file.
# Composes with the torch-extension-build fragment (see the trailing note) and, like it,
# relies on cpp-standard for $CXXSTD (== cmsdist %{cms_cxx_standard}).

# cmsdist: %define enable_cpp_api yes  (consumed by torch-extension-build's PipPostBuild)
enable_cpp_api=yes

# cmsdist: %define patchsrc — runs in the unpacked source root ($PYPI_SRC) via runIt.
# Pin CMake C++ standard to $CXXSTD and append -std=c++$CXXSTD to the extension's cxx flags.
# (Unlike torch-scatter/cluster, torch-sparse has no use_ninja=False edit.) The bare greps
# are guards: they abort (set -e) if upstream no longer contains the expected strings.
PipPatchSource=$(cat <<'EOF'
grep -q 'CMAKE_CXX_STANDARD 14' CMakeLists.txt
sed -i -e "s|CMAKE_CXX_STANDARD 14|CMAKE_CXX_STANDARD ${CXXSTD}|" CMakeLists.txt
grep "'cxx': \['-O3'\]" setup.py
sed -i -e "s|'cxx': \['-O3'\]|'cxx': ['-O3', '-std=c++${CXXSTD}']|" setup.py
EOF
)

# cmsdist: ## INCLUDE pip/files/torch-extension-build
# -> compose with torch-extension-build.file (PipPreBuild + PipPostBuild). Include wiring TBD.
