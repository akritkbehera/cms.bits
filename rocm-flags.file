# Port of cmsdist's rocm/flags.file: the ROCm compilation flags, defined once so they can
# be shared by SCRAM-based and regular tools. #!include this where cmsdist's real spec
# does `## INCLUDE rocm/flags`.

# build support for Instinct MI210/MI250X (gfx90a), Instinct MI300X (gfx942),
# Radeon Pro W7800/W7900 (gfx1100), and Radeon Pro W7600 (gfx1102)
rocm_archs="gfx90a:sramecc+ gfx942:sramecc+ gfx1100 gfx1102"

# LLVM/hipcc style for listing the supported ROCm compute architectures
hipcc_flags_rocm_archs=""
for arch in $rocm_archs; do
  hipcc_flags_rocm_archs="${hipcc_flags_rocm_archs}--offload-arch=${arch} "
done

# all ROCm flags
rocm_flags="$hipcc_flags_rocm_archs"

# cmake GPU_TARGETS style: same list, no sramecc qualifier, ';'-separated
rocm_targets="$(sed 's/:sramecc+//g; s/ /;/g' <<< "$rocm_archs")"
