# Umbrella fragment: bundles every compilation/microarch/vectorization flags
# fragment (mirrors toolflags.sh's own include list) so a tool-xml generator
# recipe (e.g. cmssw-tool-conf.sh) can pull in all of them with a single
# #!include, instead of listing each one individually.
#!include <compilation-flags.file>
#!include <compilation-flags-lto.file>
#!include <microarch-flags.file>
#!include <cuda-flags.file>
#!include <rocm-flags.file>
#!include <warning-flags.file>
#!include <vecgeom-opt.file>
#!include <frame_pointer-opt.file>
#!include <openmpi-opt.file>
